# Bot token from Developer Portal > Bot. Keep it private; never commit .env.
DISCORD_TOKEN=
# Application ID from Developer Portal > General Information (not the public key).
DISCORD_CLIENT_ID=
# Test server ID, not a channel ID. Required for default command registration.
# Global registration requires both clearing this field and passing --global explicitly.
DISCORD_GUILD_ID=

DEFAULT_TIMEZONE=UTC
# Defaults to ./data/countdowns.db. Set an absolute path for persistent hosting.
# DATABASE_PATH=./data/countdowns.db
SITE_BASE_URL=https://onlinealarmkur.com
# Optional public links shown as buttons in /countdown-help. Recommended for a
# public App Directory listing. Must be https:// URLs.
SUPPORT_SERVER_URL=
PRIVACY_POLICY_URL=

# Provisional active-inventory bounds; measure on your real host before changing.
# These are not guarantees of on-time delivery during a synchronized burst.
MAX_ACTIVE_COUNTDOWNS_PER_GUILD=5000
MAX_ACTIVE_COUNTDOWNS_TOTAL=10000
# Separate per-member anti-spam policy, not machine capacity.
MAX_ACTIVE_COUNTDOWNS_PER_USER=10
MAX_CREATIONS_PER_MINUTE=5
